{
  "name": "jenkins-api-tool",
  "version": "1.0.0",
  "description": "Jenkins RESTful API client SDK for Node.js",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsx",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "jenkins": "tsx src/cli/index.ts",
    "merge": "tsx ./examples/05-version-merge-workflow.ts",
    "pty-pcx": "tsx ./examples/01-build-pty-pcx-full-workflow.ts",
    "pcx": "tsx ./examples/02-build-pcx-full-workflow.ts",
    "patch": "tsx ./examples/build-patch-workflow.ts",
    "gwwy": "tsx ./examples/03-build-gwwy-full-workflow.ts",
    "gwwy-online": "tsx ./examples/04-build-gwwy-uniapp-online.ts"
  },
  "keywords": [
    "jenkins",
    "api",
    "ci-cd",
    "build",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "eslint": "^10.8.1",
    "ts-node": "^10.9.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
